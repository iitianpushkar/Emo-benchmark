# check embedding files for NaN/Inf rows

import torch

paths = {
    "train": "/kaggle/working/embeddings/qwen2_5_vl_3b_shared/meld_train.pt",
    "dev": "/kaggle/working/embeddings/qwen2_5_vl_3b_shared/meld_dev.pt",
    "test": "/kaggle/working/embeddings/qwen2_5_vl_3b_shared/meld_test.pt",
}

for split, path in paths.items():
    payload = torch.load(path, map_location="cpu", weights_only=False)
    x = payload["embeddings"].float()

    bad_mask = ~torch.isfinite(x).all(dim=1)
    bad_rows = bad_mask.nonzero(as_tuple=True)[0].tolist()

    print("\n", split)
    print("shape:", tuple(x.shape))
    print("bad rows:", bad_rows[:20])
    print("bad count:", len(bad_rows))
    print("nan count:", torch.isnan(x).sum().item())
    print("inf count:", torch.isinf(x).sum().item())
    print("errors:", len(payload.get("errors", [])))

    if bad_rows:
        for i in bad_rows[:5]:
            print("bad sample:", payload["sample_ids"][i])


# clean embedding files

import torch

def clean_embedding_file(src, dst):
    payload = torch.load(src, map_location="cpu", weights_only=False)
    x = payload["embeddings"].float()
    keep = torch.isfinite(x).all(dim=1)

    payload["embeddings"] = payload["embeddings"][keep]
    payload["labels"] = payload["labels"][keep]

    if "sample_ids" in payload:
        payload["sample_ids"] = [v for v, k in zip(payload["sample_ids"], keep.tolist()) if k]

    if "metadata" in payload:
        payload["metadata"] = [v for v, k in zip(payload["metadata"], keep.tolist()) if k]

    torch.save(payload, dst)

    print(src)
    print("removed:", int((~keep).sum()))
    print("kept:", int(keep.sum()))
    print("saved:", dst)
    print()

clean_embedding_file(
    "/kaggle/working/embeddings/qwen2_5_vl_3b_shared/meld_train.pt",
    "/kaggle/working/embeddings/qwen2_5_vl_3b_shared/meld_train_clean.pt",
)

clean_embedding_file(
    "/kaggle/working/embeddings/qwen2_5_vl_3b_shared/meld_dev.pt",
    "/kaggle/working/embeddings/qwen2_5_vl_3b_shared/meld_dev_clean.pt",
)

clean_embedding_file(
    "/kaggle/working/embeddings/qwen2_5_vl_3b_shared/meld_test.pt",
    "/kaggle/working/embeddings/qwen2_5_vl_3b_shared/meld_test_clean.pt",
)


